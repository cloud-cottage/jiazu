# ============================================
# 家族历史数字馆 (jiazu) — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# ---- 腾讯云 COS (S3 兼容) ----
# 注意: Gramps-Web 使用标准 boto3 AWS 环境变量对接 COS
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=jiazu-main
COS_REGION=ap-beijing
COS_ENDPOINT=https://cos.ap-beijing.myqcloud.com

# ---- Gramps-Web 必需配置 ----
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
GRAMPSWEB_SECRET_KEY=change_me_to_random_50_chars
GRAMPSWEB_ADMIN_EMAIL=admin@jiazutong.cn
GRAMPSWEB_ADMIN_PASSWORD=change_me_after_first_login

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password

# ---- 投稿联系邮箱 ----
CONTACT_EMAIL=history@jiazutong.cn

# ---- 部署环境 ----
DEPLOY_ENV=production
