# ============================================
# auth-server 环境变量
# 复制为 .env 并填入真实值
# ============================================

# 服务端口（默认 3000）
PORT=3000

# JWT 签名密钥（务必更换为随机长字符串）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=dev-only-secret-change-me

# 验证码有效期（秒，默认 300 = 5 分钟）
CODE_TTL_SECONDS=300

# 短信服务商（开发阶段用控制台打印，上线换腾讯云 SMS）
SMS_PROVIDER=console            # console | tencent
SMS_SDK_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# 管理员手机号（此号码注册后自动获得 admin 角色，可编辑 tree-meta）
ADMIN_PHONE=

# ---- 上游 Gramps-Web ----
GRAMPS_BASE_URL=http://localhost:8000

# 访客只读账号（匿名浏览用，由管理员在 Gramps 后台创建）
GRAMPS_GUEST_USERNAME=guest
GRAMPS_GUEST_PASSWORD=GuestPass123!

# 站点管理员账号（创建新 tree 用）
GRAMPS_ADMIN_USERNAME=admin
GRAMPS_ADMIN_PASSWORD=AdminPass123!

# 原 tree 的所有者账号（导出/删除子树用）
GRAMPS_OWNER_USERNAME=owner
GRAMPS_OWNER_PASSWORD=OwnerPass123!

# Gramps CLI 命令（创建新 tree 的 owner 账号用）
# 本地 venv: /path/to/.venv/bin/python /path/to/scripts/run-gramps-webapi.py --config /path/to/gramps_config/config.cfg
# 生产 Docker: docker compose exec -T grampsweb gramps-web-api --config /gramps_config/config.cfg
GRAMPS_CLI_CMD=

# ---- 数据存储 ----
AUTH_DB_PATH=./data/auth.db
